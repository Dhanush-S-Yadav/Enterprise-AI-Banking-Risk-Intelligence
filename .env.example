# Copy this file to .env. Default project uses Ollama locally and never calls paid APIs.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=550
CHUNK_OVERLAP=90
RETRIEVAL_TOP_K=8
RERANK_TOP_K=5
MAX_UPLOAD_MB=20
FRONTEND_ORIGIN=http://localhost:5173
# Demo credentials (all seven users). CHANGE THIS BEFORE USE BEYOND LOCAL DEMONSTRATION.
DEMO_PASSWORD=Demo@12345
# Optional: JWT_SECRET_KEY=generate-a-random-long-secret
# Optional: BANK_DATA_DIR=C:/BankingAI/data
